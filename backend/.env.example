# Copy this file to .env and adjust values.

# Environment: local | dev | prod
ENVIRONMENT=local

# Async PostgreSQL connection string (must use the asyncpg driver).
POSTGRES_DATABASE_URL=postgresql+asyncpg://autoflow:autoflow@localhost:5432/autoflow

# Auth — generate a strong random value for dev/prod.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS — comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# File uploads — directory for bank statement PDFs (Issue #20).
UPLOAD_DIR=./uploads
